# ─────────────────────────────────────────────────────────────
# Esmalia — variables de entorno para self-hosting (VPS / Docker) y Vercel
# Copia este archivo como .env y completa los valores.
#
# ⚠️  NUNCA commitear .env. Ya está en .gitignore.
# ─────────────────────────────────────────────────────────────

# ─── Runtime del servidor ──────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Preset de build de Nitro: node-server para VPS/Docker; vercel para Vercel.
NITRO_PRESET=node-server

# ─── Backend (Supabase / Postgres) ─────────────────────────────────
# Se inyectan en el bundle del navegador: deben estar presentes EN BUILD-TIME.
# Se obtienen del dashboard de Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=tu-project-ref

# ⚠️ Solo servidor. NUNCA exponer al navegador ni commitear.
# Se obtiene del mismo dashboard → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: conexión directa a Postgres para migraciones/backups.
SUPABASE_DB_URL=

# ─── URL pública (enlaces en emails, OAuth, sitemap) ───────────────
PUBLIC_APP_URL=https://esmalia.com

# ─── Inteligencia artificial ───────────────────────────────────────
# ⛔ Patty está PAUSADA (docs/IA.md). Interruptor general: solo "true" la
# prende. Sin definir = apagada, aunque haya claves cargadas. No prenderla
# en producción sin cumplir los requisitos de docs/IA.md.
# AI_ENABLED=false
# Orden de resolución automático: GEMINI_API_KEY → OPENAI_API_KEY.
# Clave del proveedor:
#   Gemini: https://aistudio.google.com/app/apikey
#   OpenAI: https://platform.openai.com/api-keys
GEMINI_API_KEY=
OPENAI_API_KEY=
# Opcionales: forzar proveedor y modelo específico.
# AI_PROVIDER=gemini        # gemini | openai
# AI_MODEL=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini

# ─── Email (confirmaciones/recordatorios de cita + notificaciones de revisión clínica) ──
# Resend: https://resend.com/api-keys
EMAIL_FROM=avisos@tuclinica.com
RESEND_API_KEY=
# Sin RESEND_API_KEY o EMAIL_FROM no sale ningún email (el intento queda
# registrado como 'failed' con motivo claro, no rompe nada).
#
# El modo sandbox (bloquear/redirigir envíos mientras se valida la
# entregabilidad) YA NO se controla por env var: vive en la tabla
# `email_sandbox_config` por clínica y se edita en /sandbox-email. La misma
# config la lee el servidor al enviar (lib/email.server.ts +
# resolveEmailRecipient) — antes eran dos gates desconectados (localStorage
# vs env var), unificado el 2026-08-26. Default sin fila = modo sandbox.

# ─── Correos de ciclo de vida a la clínica (docs/CORREOS.md) ───────
# Bienvenida, fin de prueba, suscripción activa, pago fallido y el reporte
# semanal. Solo a dueños/administradores, nunca a pacientes. Requieren
# RESEND_API_KEY + EMAIL_FROM y la tabla `lifecycle_emails` (migración
# 20261012000000). Activación paso a paso: docs/DOMINIO_RUNBOOK.md, paso 6b.
#
# Interruptor general: sin "true" no sale ningún correo y el cron no toca la base.
LIFECYCLE_EMAILS_ENABLED=false
# Modo de prueba: si tiene una dirección, TODOS los correos van ahí con el
# asunto "[PRUEBA → destinatario real] ...". Vaciarla para enviar de verdad.
LIFECYCLE_EMAIL_REDIRECT_TO=
# Secreto (32+ bytes al azar) que firma el enlace "Dejar de recibir este
# resumen". Generar con: openssl rand -base64 48
# Sin él: en desarrollo se usa uno al azar por proceso; en producción el
# reporte semanal NO se envía (un correo opcional sin baja funcional no sale).
# Rotarlo invalida los enlaces de baja ya enviados.
EMAIL_UNSUBSCRIBE_SECRET=
# Opcional: a dónde van las respuestas ("responde este correo"). Vacío = EMAIL_FROM.
EMAIL_REPLY_TO=

# ─── Monitoreo — Sentry (errors) ───────────────────────────────────
# Crear proyecto React en https://sentry.io. Copiar el DSN del onboarding.
# El código chequea si está presente; sin DSN no crashea, solo no reporta.
#
# ⚠️ SON DOS VARIABLES, con el MISMO DSN. `readDsn()` en src/lib/sentry.ts lee
# nombres distintos según el lado: `VITE_SENTRY_DSN` para el bundle del cliente
# (Vite solo inyecta las VITE_*) y `SENTRY_DSN` para el runtime de Node. Setear
# solo una deja la otra mitad apagada en silencio — que es exactamente lo que
# pasaba: este archivo listaba solo SENTRY_DSN, así que seguirlo al pie de la
# letra dejaba los errores del navegador sin reportar y nadie se enteraba.
#
# ⚠️ Antes de setear VITE_SENTRY_DSN en producción hay un checklist obligatorio
# de PII en src/lib/sentry.ts:95 — Esmalia manda datos clínicos y los mensajes de
# error de Postgres pueden citar valores de columnas reales.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Tag para diferenciar preview/staging/production en Sentry.
SENTRY_ENVIRONMENT=production
# 0.0-1.0. En prod arrancar bajo (0.1) para no llenar cuota gratis.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Billing — Stripe (pendiente implementar en Fase 7) ────────────
# https://dashboard.stripe.com/apikeys
# Producción: usar keys que empiezan con sk_live_ y pk_live_.
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# Webhook: crear endpoint en https://esmalia.com/api/stripe/webhook
# desde el dashboard de Stripe, copiar el signing secret aquí.
STRIPE_WEBHOOK_SECRET=
# Precios de fundador (2026-08-22) — dos tiers, no un flat único.
# No son secretos (aparecen en la URL de checkout), pero igual van por env
# var para poder rotarlos sin redeploy de código. Versión VITE_ (mismo
# valor) para que el cliente pueda mostrar qué plan está activo sin pedirle
# nada al server.
STRIPE_PRICE_ID_SOLO_MONTHLY=
STRIPE_PRICE_ID_CLINIC_MONTHLY=
VITE_STRIPE_PRICE_ID_SOLO_MONTHLY=
VITE_STRIPE_PRICE_ID_CLINIC_MONTHLY=

# ─── Portal del paciente v2 ────────────────────────────────────────
# Secret HMAC (32+ bytes random) para firmar los links del portal.
# Generar con: openssl rand -base64 48
# En dev, si está vacío, se usa un secret hardcoded inseguro (warning en
# consola). En producción es OBLIGATORIO. Rotar invalida todos los links
# firmados existentes (usuarios tendrán que pedir uno nuevo).
PORTAL_TOKEN_SECRET=

# ─── Clínica demo pública ───────────────────────────────────────────
# Secret que valida el request del cron de reset (src/routes/api.demo-reset.ts),
# del resumen diario y de los correos de ciclo de vida (GitHub Actions lo
# manda como secret de repo con el mismo nombre).
# Generar con: openssl rand -base64 32
# Configurar el mismo valor en vercel.json (crons llama con este Authorization
# header automáticamente en Vercel) y en esta env var.
CRON_SECRET=

# ─── WhatsApp (Fase 1 — Cloud API directo, Esmalia como Tech Provider) ────
# Sin esto seteado, /whatsapp muestra "todavía no habilitado" y todo sigue
# funcionando por wa.me manual (fallback automático, nunca se rompe nada).
# Requiere enrolarse en el programa Tech Provider de Meta primero:
#   https://developers.facebook.com/docs/whatsapp/tech-provider-program
#
# App ID y App Secret: Meta App Dashboard → Configuración básica.
# App ID NO es secreto (se expone al navegador también, ver VITE_ abajo).
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Opcional, respaldo: System User token del portafolio con
# whatsapp_business_messaging + whatsapp_business_management. El envío usa
# el token de negocio de cada clínica (Embedded Signup), guardado cifrado en
# whatsapp_credentials; este solo se usa si una clínica no lo tiene.
WHATSAPP_SYSTEM_USER_TOKEN=
# 32 bytes en base64 (`openssl rand -base64 32`). Cifra el token de negocio y
# el PIN de cada clínica. Si se pierde, cada clínica tiene que reconectar.
WHATSAPP_CREDENTIALS_KEY=
# String propio (inventalo vos, ej. `openssl rand -hex 16`) para el
# handshake GET del webhook con Meta Business Manager.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Versión de la Graph API fijada, para no romper ante cambios de Meta.
WHATSAPP_API_VERSION=v25.0

# Client-side: mismo App ID de arriba (no es secreto), más el Config ID de
# Embedded Signup v4 (Meta App Dashboard → Facebook Login for Business →
# Configurations → variante "WhatsApp Embedded Signup", producto Cloud API).
VITE_WHATSAPP_APP_ID=
VITE_WHATSAPP_CONFIG_ID=
VITE_WHATSAPP_API_VERSION=v25.0

# WhatsApp de ventas de Esmalia (público, formato internacional, ej. 56912345678).
# Lo usan los CTA "Hablar por WhatsApp" de la landing; vacío = cae al email.
VITE_SALES_WHATSAPP=

# Emails del equipo de Esmalia habilitados a leer los leads de marketing.
# Separados por coma. Sin esta variable, nadie puede leerlos desde la app.
ESMALIA_STAFF_EMAILS=

# A quién le llega por correo el aviso de un lead nuevo (separados por coma).
# Vacío = los mismos de ESMALIA_STAFF_EMAILS. En producción: solo el correo de la
# empresa, aunque /admin también lo use la cuenta personal de Walter.
LEADS_NOTIFY_EMAILS=
