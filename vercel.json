{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".vercel/output",
  "github": {
    "silent": true
  },
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/demo-reset",
      "schedule": "5 5 * * *"
    },
    {
      "path": "/api/daily-digest",
      "schedule": "37 * * * *"
    },
    {
      "path": "/api/lifecycle-emails",
      "schedule": "47 * * * *"
    },
    {
      "path": "/api/patient-emails",
      "schedule": "27 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        }
      ]
    },
    {
      "source": "/((?!reservar/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/_serverFn/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(agenda|ajustes|aranceles|cajas|caja|comisiones|compliance|consentimientos|convenios|conversaciones|dashboard|dominio-email|efectividad|equipo|estados-de-cita|finanzas|fusionar-fichas|gastos|inventario|laboratorios|medios-de-pago|mensajes|mi-agenda|morosidad|ortodoncia|pacientes|permisos|preferencias|profesionales|pruebas-email|recordatorios|reportes|sandbox-email|sucursales|suscripcion|tratamientos|whatsapp|admin|onboarding|sin-acceso|portal|portal-laboratorio|correos|formulario|encuesta|notificaciones-a-pacientes)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "alika-omega.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/login", "destination": "/auth", "permanent": true },
    { "source": "/ingresar", "destination": "/auth", "permanent": true },
    { "source": "/registro", "destination": "/auth?signup=true", "permanent": true },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.esmalia.com"
        }
      ],
      "destination": "https://esmalia.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.esmalia.com"
        }
      ],
      "destination": "https://esmalia.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "alika-omega.vercel.app"
        }
      ],
      "destination": "https://esmalia.com/",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "alika-omega.vercel.app"
        }
      ],
      "destination": "https://esmalia.com/:path",
      "permanent": true
    }
  ]
}
